# LLM Providers (set the one you use)
OPENAI_API_KEY=
SILICONFLOW_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# X Brief LLM (orchestrator，默认 SiliconFlow MiniMax-M2.5)
XBRIEF_ORCHESTRATOR_PROVIDER=siliconflow
XBRIEF_ORCHESTRATOR_MODEL=Pro/MiniMaxAI/MiniMax-M2.5
XBRIEF_ORCHESTRATOR_BASE_URL=https://api.siliconflow.cn/v1

# X Brief 数据：账号列表优先读 data/x_brief/，若无 简报配置.md/关注列表.md 则读 docs/x资讯/；缓存与 md 输出写在 data/x_brief/。见 docs/x_brief.md
# 推文源顺序：nitter, snscrape, rsshub
# X_SOURCE_PRIORITY=nitter,snscrape,rsshub
